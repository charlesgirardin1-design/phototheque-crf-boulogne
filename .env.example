# Copiez ce fichier en .env.local pour le développement local.
# En production, renseignez ces variables dans Vercel : Settings → Environment Variables.
# Ne mettez JAMAIS de vraies valeurs dans ce fichier : il est versionné.

# --- Base de données PostgreSQL (Neon recommandé, ou Supabase / tout Postgres) ---
# Utilisez l'URL « pooled » (avec -pooler pour Neon, port 6543 pour Supabase).
DATABASE_URL=

# --- Authentification (côté serveur uniquement) ---
# Secret de signature des sessions, 32 caractères minimum : `openssl rand -base64 48`
AUTH_SECRET=
# Mot de passe du profil « Utilisateur »
USER_PASSWORD=
# Mot de passe du profil « Administrateur »
ADMIN_PASSWORD=

# --- Stockage des fichiers : Vercel Blob privé (recommandé) ---
# Sur Vercel, reliez un Blob privé au projet (onglet Storage) : BLOB_STORE_ID est ajouté
# automatiquement et l'authentification se fait par OIDC. En local : BLOB_READ_WRITE_TOKEN.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# --- OU stockage compatible S3 (Cloudflare R2, AWS…), utilisé si aucun Blob n'est relié ---
# R2 : https://<ACCOUNT_ID>.r2.cloudflarestorage.com  — laisser vide pour AWS S3
S3_ENDPOINT=
# R2 : auto — AWS : ex. eu-west-3
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true pour MinIO / certains fournisseurs ; false pour R2 et AWS
S3_FORCE_PATH_STYLE=false

# --- Optionnel ---
# Taille maximale d'un fichier importé, en Mo (max. 5120). Défaut : 5000
MAX_UPLOAD_SIZE_MB=
# Secret de la tâche planifiée de nettoyage (Vercel l'envoie automatiquement aux crons)
CRON_SECRET=
# Origines autorisées pour le CORS du bucket (script npm run storage:cors), séparées par des virgules
# ex. https://phototheque-crf-boulogne.vercel.app,http://localhost:3000
APP_ORIGINS=
